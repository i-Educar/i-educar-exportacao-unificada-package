{
    "name": "buriti/i-educar-exportacao-unificada-package",
    "description": "Exportação unificada de listas e relatórios (TR 4.x Laguna) para o i-Educar 2.12.",
    "version": "0.1.0",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": ["ieducar", "exportacao", "buriti", "laguna"],
    "authors": [{"name": "Buriti"}],
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-zip": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Packages\\BuritiExportacaoUnificada\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Packages\\BuritiExportacaoUnificada\\Providers\\ExportacaoUnificadaServiceProvider"
            ]
        },
        "ieducar": {
            "compatible": ["2.12"]
        }
    },
    "config": {
        "sort-packages": true
    }
}
